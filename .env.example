# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key, server-side only. Used by /api/discover, /api/generate-email
# and /api/cron/generate-drafts.
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: Hunter.io key for contact email lookup during lead discovery.
HUNTER_API_KEY=your-hunter-key

# Optional: Resend key for real sending. Only used if a campaign has a sender_email.
RESEND_API_KEY=re_your-key

# When true, /api/send-email never calls Resend and returns a fake id instead.
DEMO_MODE=true
